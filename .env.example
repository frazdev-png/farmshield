# FarmShield AI Development Environment Variables
# Copy to .env and adjust credentials as appropriate

# PostgreSQL 16 Configuration
POSTGRES_DB=farmshield_db
POSTGRES_USER=farmshield_user
POSTGRES_PASSWORD=farmshield_password_change_in_production
POSTGRES_PORT=5432

# Backend Database URL for PostgreSQL 16
DATABASE_URL=postgresql+psycopg2://farmshield_user:farmshield_password_change_in_production@localhost:5432/farmshield_db

# Isolated Test Database URL (Never use development or production database for test runs)
TEST_DATABASE_URL=postgresql+psycopg2://farmshield_user:farmshield_password_change_in_production@localhost:5432/farmshield_test_db

# JWT Security
JWT_SECRET_KEY=replace-with-a-very-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

