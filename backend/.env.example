# Environment configuration for FarmShield AI Backend
APP_NAME="FarmShield AI Backend"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Bindings
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# PostgreSQL 16 Database Configuration
DATABASE_URL=postgresql+psycopg2://farmshield_user:farmshield_password@localhost:5432/farmshield_db
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Isolated Test Database (Used exclusively for pytest runs against PostgreSQL)
TEST_DATABASE_URL=postgresql+psycopg2://farmshield_user:farmshield_password@localhost:5432/farmshield_test_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-very-strong-and-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Strands AI & Amazon Bedrock Model Configuration
STRANDS_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
STRANDS_TIMEOUT_SECONDS=30

# AWS SNS SMS Notification Configuration
SNS_SMS_ENABLED=false
SNS_SMS_SENDER_ID=FarmShield
SNS_SMS_MAX_PRICE=0.05
SNS_SMS_TYPE=Transactional
FARMSHIELD_DASHBOARD_URL=http://localhost:5173
SNS_SMS_MAX_RETRIES=3
SNS_SMS_RETRY_BACKOFF_SECONDS=1.0
